---
import { Image } from 'astro:assets';
import '../styles/global.css';
import pfp from '../assets/fadepfp.png';

import HomeLayout from '../layouts/HomeLayout.astro';

import Header from '../components/Header.astro';
import ProfileCard from '../components/ProfileCard.astro';
import Terminal from '../components/Terminal.astro';
import PhotoCollage from '../components/PhotoCollage.astro';
import BlogHomeList from '../components/BlogHomeList.astro';

---

<HomeLayout title="v9 Labs">
    <main class="page">
        <Header />
 
        <div class="body-grid">
            <div class="left-col">
                <ProfileCard />
                <Terminal />
            </div>
 
            <div class="right-col">
                <div class="bottom-row">
                    <BlogHomeList />
                    <!-- <AnonymousBox /> -->
                </div>
                <PhotoCollage />
            </div>
        </div>
    </main>
</HomeLayout>
 
<style is:global>
    html,
    body {
        height: 100%;
        overflow: hidden;
    }
</style>
 
<style>
    .page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1.25rem;
        height: 100vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
 
    .body-grid {
        flex: 1;
        display: grid;
        grid-template-columns: minmax(260px, 40%) 1fr;
        grid-template-rows: 1fr;
        gap: 0.5rem;
        min-height: 0;
    }
 
    .left-col {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-height: 0;
    }
 
    .left-col :global(.terminal) {
        flex: 1;
        min-height: 0;
    }
 
    .right-col {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-height: 0;
    }
 
    .right-col :global(.photo-collage) {
        flex: 0 0 55%;
        min-height: 0;
    }
 
    .bottom-row {
        flex: 1;
        display: grid;
        /* grid-template-columns: 2.2fr 1fr; */
        grid-template-rows: 1fr;
        gap: 0.5rem;
        min-height: 0;
        /* background-color: red; */
    }
 
    @media (max-width: 860px) {
        :global(html),
        :global(body) {
            height: auto;
            overflow: visible;
        }
 
        .page {
            height: auto;
            overflow: visible;
        }
 
        .body-grid {
            grid-template-columns: 1fr;
            grid-template-rows: auto auto;
        }
 
        .bottom-row {
            grid-template-columns: 1fr;
            grid-template-rows: auto auto;
        }
 
        .left-col :global(.terminal) {
            flex: none;
        }
 
        .right-col :global(.photo-collage) {
            flex: none;
        }
    }
</style>
