---
import { getImage, Image } from 'astro:assets';
import { galleryImages } from '../lib/galleryImages';

// Precompute a full-resolution (original width, quality 100) source for each
// image at build time, so the lightbox never re-processes anything on click.
const fullImages = await Promise.all(
  galleryImages.map((img) =>
    getImage({ src: img.src, width: img.src.width, quality: 100 })
  )
);
---
<section class="photo-collage">
    <div class="collage-head">
        <span class="collage-title">gallery</span>
    </div>

    <div class="photo-grid-scroll">
        <div class="photo-grid" id="photo-grid">
            {galleryImages.map((img, i) => (
                <button
                    type="button"
                    class="photo-item"
                    data-full={fullImages[i].src}
                    data-width={img.src.width}
                    data-height={img.src.height}
                    data-alt={img.name}
                >
                    <Image
                        src={img.src}
                        alt={img.name}
                        widths={[300, 450, 700]}
                        sizes="(max-width: 1100px) 45vw, 260px"
                        quality={90}
                        loading="lazy"
                        decoding="async"
                    />
                </button>
            ))}
        </div>
    </div>
</section>

<dialog id="lightbox" class="lightbox">
    <button type="button" class="lightbox-close" aria-label="Close">✕</button>
    <img id="lightbox-img" alt="" />
</dialog>

<style>
    .photo-collage {
        border: 1px solid var(--c-photos);
        border-radius: var(--radius);
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-height: 0;
    }

    .collage-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

    .collage-title {
        color: var(--c-photos);
        font-size: 0.8rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .photo-grid-scroll {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-gutter: stable;

        /* Themed scrollbar — Firefox/standard */
        scrollbar-width: thin;
        scrollbar-color: var(--c-photos) transparent;
    }

    /* Themed scrollbar — Chrome/Safari/Edge */
    .photo-grid-scroll::-webkit-scrollbar {
        width: 8px;
    }
    .photo-grid-scroll::-webkit-scrollbar-track {
        background: transparent;
    }
    .photo-grid-scroll::-webkit-scrollbar-thumb {
        background-color: var(--c-photos);
        border-radius: 0;
    }

    .photo-grid {
        column-count: 3;
        /* column-gap: 0.6rem; */
        column-gap: 0.1rem;
        opacity: 0;
        transition: opacity 0.15s ease;
    }

    .photo-grid.is-ready {
        opacity: 1;
    }

    @media (max-width: 1100px) {
        .photo-grid { column-count: 2; }
    }

    .photo-item {
        all: unset;
        display: block;
        cursor: pointer;
        break-inside: avoid;
        margin-bottom: 0.6rem;
        /* margin-bottom: 0.35rem; */
        line-height: 0;
        border: none;
        border-radius: 0;
    }

    .photo-item:focus-visible {
        outline: 2px solid var(--c-photos);
        outline-offset: 2px;
    }

    .photo-item :global(img) {
        display: block;
        width: 100%;
        height: auto;
        border: none;
        border-radius: 0;
    }

    .lightbox {
        border: none;
        border-radius: 0;
        padding: 0;
        background: transparent;
        max-width: 90vw;
        max-height: 90vh;
    }

    .lightbox::backdrop {
        background: rgba(0, 0, 0, 0.85);
    }

    .lightbox img {
        display: block;
        max-width: 90vw;
        max-height: 90vh;
        width: auto;
        height: auto;
        border: none;
        border-radius: 0;
    }

    .lightbox-close {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        background: transparent;
        border: 1px solid var(--c-photos);
        border-radius: 0;
        color: var(--c-photos);
        width: 28px;
        height: 28px;
        cursor: pointer;
    }
</style>

<script>
    const grid = document.getElementById('photo-grid');

    if (grid) {
        const items = Array.from(grid.children);
        for (let i = items.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [items[i], items[j]] = [items[j], items[i]];
        }
        items.forEach((item) => grid.appendChild(item));
        grid.classList.add('is-ready');
    }

    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const closeBtn = document.querySelector<HTMLButtonElement>('.lightbox-close');

    document.querySelectorAll<HTMLButtonElement>('.photo-item').forEach((item) => {
        item.addEventListener('click', () => {
            if (!dialog || !lightboxImg) return;
            lightboxImg.src = item.dataset.full ?? '';
            lightboxImg.alt = item.dataset.alt ?? '';
            dialog.showModal();
        });
    });

    closeBtn?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
    });
</script>
