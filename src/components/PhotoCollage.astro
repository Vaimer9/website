<section class="photo-collage">
    <div class="collage-head">
        <span class="collage-title">gallery</span>
        <button
            class="refresh-btn"
            id="refresh-photos"
            title="Refresh photos"
            aria-label="Refresh photos"
        >
            ⟳
        </button>
    </div>

    <div class="photo-grid">
        <div class="photo-item p1">photo</div>
        <div class="photo-item p2">photo</div>
        <div class="photo-item p3">photo</div>
        <div class="photo-item p4">photo</div>
        <div class="photo-item p5">photo</div>
        <div class="photo-item p6">photo</div>
    </div>
</section>

<style>
    .photo-collage {
        border: 2px solid var(--c-photos);
        border-radius: var(--radius);
        /* box-shadow: 0 0 18px -6px var(--c-photos); */
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-height: 0;
    }

    .collage-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
    }

    .collage-title {
        color: var(--c-photos);
        font-size: 0.8rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .refresh-btn {
        background: transparent;
        border: 1px solid var(--c-photos);
        color: var(--c-photos);
        border-radius: 8px;
        width: 28px;
        height: 28px;
        cursor: pointer;
        font-size: 0.95rem;
        line-height: 1;
        transition: transform 0.4s ease;
    }

    .refresh-btn:hover {
        transform: rotate(180deg);
    }

    .photo-grid {
        flex: 1;
        display: grid;
        grid-template-columns: 1fr 1fr 1.6fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 0.6rem;
        min-height: 200px;
    }

    .photo-item {
        border: 1.5px solid var(--c-photos);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--c-photos);
        font-size: 0.8rem;
        opacity: 0.85;
    }

    .p1 {
        grid-column: 1;
        grid-row: 1 / 3;
    }
    .p2 {
        grid-column: 2;
        grid-row: 1;
    }
    .p3 {
        grid-column: 3;
        grid-row: 1;
    }
    .p4 {
        grid-column: 4;
        grid-row: 1 / 3;
    }
    .p5 {
        grid-column: 2;
        grid-row: 2;
    }
    .p6 {
        grid-column: 3;
        grid-row: 2;
    }
</style>

