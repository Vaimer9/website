---
---
<section class="terminal">
    <div class="term-bar">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
        <span class="term-title">guest@vaimer9: ~</span>
    </div>

    <div class="term-body" id="term-body">
        <p class="line">
            Welcome. Type <span class="hl">help</span> to see available commands.
        </p>
        <p class="line prompt-line" id="prompt-line">
            <span class="prompt">
                <span class="prompt-path">guest@vaimer9:~</span><span class="prompt-symbol">$</span>
            </span>
            <span
                id="term-input"
                class="term-input"
                contenteditable="true"
                spellcheck="false"
                role="textbox"
                aria-label="terminal input"></span>
        </p>
    </div>
</section>

<style>
    .terminal {
        border: 1px solid var(--c-terminal);
        border-radius: var(--radius);
        /* box-shadow: 0 0 18px -6px var(--c-terminal); */
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-height: 0;
    }

    @media (max-width: 860px) {
        .terminal {
            height: 380px;
        }
    }

    .term-bar {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.6rem 0.9rem;
        border-bottom: 2px solid var(--c-terminal);
        flex-shrink: 0;
    }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }
    .dot.red {
        background: #ff5f56;
    }
    .dot.yellow {
        background: #ffbd2e;
    }
    .dot.green {
        background: #27c93f;
    }

    .term-title {
        margin-left: 0.6rem;
        color: var(--c-terminal);
        font-size: 0.8rem;
        opacity: 0.8;
    }

    .term-body {
        flex: 1;
        padding: 1rem 1.1rem;
        overflow-y: auto;
        font-size: 0.9rem;
        line-height: 1.6;
        min-height: 0;
        position: relative; /* anchors the matrix canvas */
    }

    .line {
        margin: 0 0 0.4rem;
        color: var(--text-dim);
    }

    .hl {
        color: var(--c-terminal);
    }

    .prompt-line {
        display: flex;
        gap: 0.5rem;
        color: var(--text);
    }

    .prompt {
        color: var(--c-terminal);
        white-space: nowrap;
    }

    .prompt-symbol {
        /* kept separate from the path so it's an explicit, styleable element */
        margin-left: 1px;
    }

    .term-input {
        flex: 1;
        outline: none;
        caret-color: var(--c-terminal);
    }

    .term-output {
        font-family: "Fira Code", "JetBrains Mono", ui-monospace, SFMono-Regular,
            Menlo, monospace;
        white-space: pre;
        overflow-x: auto;
    }

    .matrix-canvas {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 5;
    }
</style>

<script>
    interface Command {
        description: string;
        run: (args: string[]) => string | Promise<string>;
    }

    const PROMPT = "guest@vaimer9:~$";

    // Edit this to write your own about-me text — one entry per array line.
    const ABOUT_LINES = [
        "> CSE Undergrad",
        "> Programming | Mountaineering | Manga | Music",
        // TODO: add more about yourself here.
    ];

    function buildNeofetch(): string {
        const logo = [
            "      /\\",
            "     /  \\",
            "    /    \\",
            "   /      \\",
            "  /   __   \\",
            " /___|  |___\\",
        ];

        const specs = [
            "guest@vaimer9",
            "-------------",
            "OS: Arch Linux x86_64",
            "WM: niri (Wayland)",
            "Shell: zsh",
        ];

        const rows = Math.max(logo.length, specs.length);
        const lines: string[] = [];

        for (let i = 0; i < rows; i++) {
            const left = (logo[i] ?? "").padEnd(16);
            const right = specs[i] ?? "";
            lines.push(`${left}  ${right}`);
        }

        return lines.join("\n");
    }

    function buildCowsay(message: string): string {
        const border = "-".repeat(message.length + 2);
        return [
            ` ${border}`,
            `< ${message} >`,
            ` ${border}`,
            "        \\   ^__^",
            "         \\  (oo)\\_______",
            "            (__)\\       )\\/\\",
            "                ||----w |",
            "                ||     ||",
        ].join("\n");
    }

    function runMatrix(container: HTMLElement): Promise<string> {
        return new Promise((resolve) => {
            const canvas = document.createElement("canvas");
            canvas.className = "matrix-canvas";
            container.appendChild(canvas);

            const ctx = canvas.getContext("2d");
            if (!ctx) {
                canvas.remove();
                resolve("matrix: canvas not supported");
                return;
            }

            canvas.width = container.clientWidth;
            canvas.height = container.clientHeight;

            const accent =
                getComputedStyle(container).getPropertyValue("--c-terminal").trim() ||
                "#27c93f";

            const fontSize = 14;
            const columns = Math.max(1, Math.floor(canvas.width / fontSize));
            const drops = new Array(columns).fill(0);
            const glyphs = "01アイウエオカキクケコサシスセソ";

            let frame = 0;
            const totalFrames = 120;

            const timer = window.setInterval(() => {
                ctx.fillStyle = "rgba(0, 0, 0, 0.15)";
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                ctx.fillStyle = accent;
                ctx.font = `${fontSize}px monospace`;

                drops.forEach((dropRow, col) => {
                    const glyph = glyphs[Math.floor(Math.random() * glyphs.length)];
                    ctx.fillText(glyph, col * fontSize, dropRow * fontSize);
                    drops[col] =
                        dropRow * fontSize > canvas.height && Math.random() > 0.975
                            ? 0
                            : dropRow + 1;
                });

                frame += 1;
                if (frame >= totalFrames) {
                    window.clearInterval(timer);
                    canvas.remove();
                    resolve("wake up, Neo...");
                }
            }, 35);
        });
    }

    const input = document.getElementById("term-input");
    const body = document.getElementById("term-body");
    const promptLine = document.getElementById("prompt-line");

    if (input && body && promptLine) {
        const commands: Record<string, Command> = {
            help: {
                description: "list available commands",
                run: () =>
                    Object.entries(commands)
                        .map(([name, cmd]) => `${name.padEnd(10)}- ${cmd.description}`)
                        .join("\n"),
            },
            whoami: {
                description: "print the current user",
                run: () => "guest",
            },
            about: {
                description: "a little about me",
                run: () => ABOUT_LINES.join("\n"),
            },
            neofetch: {
                description: "show system info",
                run: () => buildNeofetch(),
            },
            cowsay: {
                description: "make a cow say something",
                run: (args) => buildCowsay(args.join(" ") || "Moo!"),
            },
            matrix: {
                description: "wake up, Neo...",
                run: () => runMatrix(body),
            },
            clear: {
                description: "clear the terminal",
                run: () => {
                    Array.from(body.children).forEach((child) => {
                        if (child !== promptLine) child.remove();
                    });
                    return "";
                },
            },
            sudo: {
                description: "try to gain power you don't have",
                run: () =>
                    "No.",
            },
            echo: {
                description: "print back your text",
                run: (args) => args.join(" "),
            },
            date: {
                description: "show the current date and time",
                run: () => new Date().toLocaleString(),
            },
        };

        // Runs a command exactly as if the user had typed it and hit Enter.
        // Used both by the input handler and to auto-run "about" on load.
        async function execute(raw: string): Promise<void> {
            if (!body || !promptLine) return;

            const echoed = document.createElement("p");
            echoed.className = "line";
            echoed.textContent = `${PROMPT} ${raw}`;
            body.insertBefore(echoed, promptLine);

            const [name, ...args] = raw.split(/\s+/);
            const command = commands[name.toLowerCase()];
            const outputText = command
                ? await command.run(args)
                : `command not found: ${name}`;

            if (outputText) {
                const result = document.createElement("pre");
                result.className = "line term-output";
                result.textContent = outputText;
                body.insertBefore(result, promptLine);
            }

            body.scrollTo({ top: body.scrollHeight });
        }

        input.addEventListener("keydown", async (event) => {
            if (event.key !== "Enter") return;
            event.preventDefault();

            const raw = (input.textContent ?? "").trim();
            input.textContent = "";
            if (!raw) return;

            await execute(raw);
        });

        // Show "about" immediately on load, no typing required.
        void execute("about");
    }
</script>
